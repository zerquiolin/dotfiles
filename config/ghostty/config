font-family = Maple Mono NF
font-family-bold = Maple Mono NF
font-family-italic = VictorMono Nerd Font Mono
font-family-bold-italic = VictorMono Nerd Font Mono
font-size = 14
font-feature = calt
font-thicken = true
font-thicken-strength = 64
background = 000000
foreground = e4f0fb
background-opacity = 0.97
background-blur = 30
background-image = ~/.config/ghostty/backgrounds/poimandres-galaxy.png
background-image-opacity = 0.35
background-image-fit = cover
background-image-position = center
macos-titlebar-style = transparent
window-padding-x = 12
window-padding-y = 10
cursor-color = a6accd
selection-background = 303340
selection-foreground = e4f0fb
palette = 0=#1b1e28
palette = 1=#d0679d
palette = 2=#5de4c7
palette = 3=#fffac2
palette = 4=#89ddff
palette = 5=#a6accd
palette = 6=#add7ff
palette = 7=#ffffff
palette = 8=#767c9d
palette = 9=#f087bd
palette = 10=#5de4c7
palette = 11=#fffac2
palette = 12=#add7ff
palette = 13=#a6accd
palette = 14=#89ddff
palette = 15=#ffffff
macos-option-as-alt = true
keybind = super+semicolon=csi:25~
keybind = super+alt+j=csi:26~
keybind = super+j=csi:28~
keybind = super+slash=csi:29~
keybind = super+s=csi:31~
keybind = super+q=csi:32~
keybind = super+v=paste_from_clipboard
keybind = performable:super+c=copy_to_clipboard

# Local appearance preferences; generated by Suite Settings.
config-file = ?../../.state/appearance/ghostty.conf
